__pycache__/
*.pyc
.DS_Store
*.egg-info/
build/
dist/
.venv/
.idea/
.vscode/
CLAUDE.md

# Build output. A compiled projection is DERIVED from source by the compiler and regenerated by
# every build: tracking it dirties the repo on each rebuild, fails the release preflight, and ships
# a derivation as if it were source. Declared from the first commit — snapshot_inspector learned
# this the hard way, having tracked 47 compiled files until release 3.
compiled/
**/compiled/
snapshot/

# Dossiers are evidence ABOUT a composition, not part of one. Generated dossiers stay local.
# Authored ones are tracked, and they now share this directory with the generated output — so the
# exclusion names what is generated and re-admits what is authored. A bare `dossiers/` would ignore
# the authored dossier too, silently, the moment it moved here.
/dossiers/*
!/dossiers/new_subdomain/
