        "code": "SCHEDULED_ARTIFACT_UNPLACED",
        "intent": "every artifact the mandate schedules declares the subdomain it is built into"
      },
      "x-reference": {
        "mode": "covers",
        "params": {
          "source_register": "build_order",
          "source_column": "Code",
          "column": "Code"
        }
      }
    },
    {
      "x-register": "field_declarations",
      "x-finding": {
        "code": "AMENDED_ARTIFACT_UNPLACED",
        "intent": "an artifact this change amends declares the subdomain it is placed in, as a scheduled one does"
      },
      "x-carriage": {
        "mode": "identities_covered",
        "params": {
          "prior_phase": "p7",
          "prior_register": "existing_inventory",
          "prior_column": "FQDN",
          "column": "Code",
          "require": "prior_in_here",
          "match_on": "bare_code",
          "prior_only_when_column": "Action",
          "prior_only_when_values": [
            "EXTEND"
          ],
          "prior_only_when_prefixes": [
            "AC_",
            "IN_",
            "WF_",
            "CC_",
            "CT_",
            "EV_",
            "RB_",
            "VOCAB_",
            "TI_",
            "TE_"
          ]
        }
      }
    },
    {
      "x-finding": {
        "code": "REGISTER_CELL_UNRESOLVED",
        "intent": "an unanswered question left in a register reads as decided to every later phase",
        "detail": "{column!r} declares the question unanswered ({marker}) rather than answering it — ask it as a clarification, do not hedge it in a register"
      },
      "x-procedure": {
        "name": "UNRESOLVED_MARKER_ABSENT",
        "params": {
          "exempt": [],
          "detail": "{column!r} declares the question unanswered ({marker}) rather than answering it — ask it as a clarification, do not hedge it in a register"
        }
      }
    },
    {
      "x-finding": {
        "code": "HEADER_FIELD_MISSING",
        "intent": "a dossier document states its phase, its CR, its lifecycle state, and what it feeds"
      },
      "properties": {
        "header": {
          "required": [
            "Stage",
            "CR",
            "Status",
            "Feeds"
          ]
        }
      }
    },
    {
      "x-finding": {
        "code": "LIFECYCLE_STATE_NOT_IN_VOCABULARY",
        "intent": "the lifecycle axis is a controlled vocabulary, not free text"
      },
      "properties": {
        "header": {
          "properties": {
            "Status": {
              "pattern": "^(DRAFT|CONSTRUCTION_COMPLETE|ADMITTED_UNVALIDATED|EXECUTION_VALIDATED|PROMOTED)\\b"
            }
          }
        }
      }
    }
